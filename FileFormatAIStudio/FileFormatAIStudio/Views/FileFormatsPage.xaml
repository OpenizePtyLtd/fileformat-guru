<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileFormatAIStudio.Views.FileFormatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileFormatAIStudio.Views"
    xmlns:models="using:FileFormatAIStudio.Models"
    xmlns:vm="using:FileFormatAIStudio.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,20,24,24" RowSpacing="16" MaxWidth="1100" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Page Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="File Formats Directory" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Comprehensive catalog of 1,464+ file formats from FileFormat.com with in-app chat compatibility and engine mappings."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{ThemeResource AccentButtonStyle}"
                    VerticalAlignment="Center"
                    Click="OnOpenDocsHomepageClicked"
                    ToolTipService.ToolTip="Open FileFormat.com knowledge base in browser">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                    <TextBlock Text="Visit FileFormat.com" FontSize="12" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Row 1: Metrics Strip -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Metric 1: Total Cataloged -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12">
                <StackPanel Spacing="2">
                    <TextBlock Text="TOTAL FORMATS" FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}"
                               FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Indexed from FileFormat.com" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Metric 2: Supported in App -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12">
                <StackPanel Spacing="2">
                    <TextBlock Text="SUPPORTED IN APP" FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.SupportedCount, Mode=OneWay}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock Text="Ready for conversational chat &amp; RAG" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Metric 3: Planned Roadmap -->
            <Border Grid.Column="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12">
                <StackPanel Spacing="2">
                    <TextBlock Text="ON ROADMAP" FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.PlannedCount, Mode=OneWay}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="Scheduled for M11+ parser engines" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Metric 4: Format Categories -->
            <Border Grid.Column="3"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12">
                <StackPanel Spacing="2">
                    <TextBlock Text="CATEGORIES" FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="32"
                               FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Word, Sheet, Audio, 3D, CAD &amp; more" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 2: Search & Filter Toolbar -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <TextBox Grid.Column="0"
                         Header="Search Formats"
                         PlaceholderText="Search by extension (.epub, .docx), name, or engine..."
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Category Filter -->
                <ComboBox Grid.Column="1"
                          Header="Category"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" />

                <!-- Status Filter -->
                <ComboBox Grid.Column="2"
                          Header="App Compatibility"
                          HorizontalAlignment="Stretch"
                          SelectedIndex="{x:Bind ViewModel.StatusFilterIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="All Formats" />
                    <ComboBoxItem Content="Supported in App (Can Chat)" />
                    <ComboBoxItem Content="Roadmap / Planned" />
                </ComboBox>
            </Grid>
        </Border>

        <!-- Row 3: Filter Results Summary -->
        <Grid Grid.Row="3">
            <TextBlock Text="{x:Bind ViewModel.FilterSummaryText, Mode=OneWay}"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Row 4: Virtualized Formats List -->
        <ListView Grid.Row="4"
                  ItemsSource="{x:Bind ViewModel.FilteredFormats, Mode=OneWay}"
                  SelectionMode="None"
                  Padding="0,0,0,16">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FileFormatItem">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: Extension Pill -->
                            <Border Grid.Column="0"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    MinWidth="80"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Extension}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Border>

                            <!-- Column 1: Format Details & Engines -->
                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                <!-- Row: Name, Category Pill, Status Badge -->
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />

                                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2">
                                        <TextBlock Text="{x:Bind CategoryDisplayName}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>

                                    <!-- Status Badge: Supported vs Roadmap -->
                                    <Border Background="{x:Bind local:FileFormatsPage.StatusBadgeBackground(IsSupported), Mode=OneWay}"
                                            BorderBrush="{x:Bind local:FileFormatsPage.StatusBadgeBorder(IsSupported), Mode=OneWay}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind StatusBadgeGlyph}"
                                                      FontSize="10"
                                                      Foreground="{x:Bind local:FileFormatsPage.StatusBadgeForeground(IsSupported), Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind StatusBadgeText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{x:Bind local:FileFormatsPage.StatusBadgeForeground(IsSupported), Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Row: Compatible Engines -->
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Open Source:"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind DefaultOssEngine}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Aspose API:"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind AsposeApi}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Column 2: Action Link to FileFormat.com -->
                            <Button Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Click="OnOpenFormatDocsClicked"
                                    Tag="{x:Bind DocsUrl}"
                                    ToolTipService.ToolTip="View static specification and documentation on FileFormat.com">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                    <TextBlock Text="FileFormat.com Docs" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

